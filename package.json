{
  "name": "gather-platform-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:redis": "playwright test --grep @redis",
    "test:e2e:ui": "playwright test --ui",
    "test:loading": "playwright test --config playwright.loading.config.ts",
    "test:loading-tools": "node --test scripts/frontend-loading.test.mjs",
    "build:loading": "node scripts/frontend-loading-build.mjs --variant both",
    "check:loading": "node scripts/frontend-loading-compare.mjs",
    "measure:loading": "node scripts/frontend-loading-measure.mjs",
    "test:cleanup": "node --test scripts/e2e-cleanup.test.mjs",
    "cleanup:e2e": "node scripts/e2e-cleanup.mjs",
    "test:backup": "node --test scripts/database-backup.test.mjs scripts/backup-restore-drill.test.mjs",
    "backup:database": "node scripts/database-backup.mjs backup",
    "restore:database": "node scripts/database-backup.mjs restore",
    "verify:restore": "node scripts/backup-restore-drill.mjs",
    "test:performance-safety": "node --test scripts/performance-check.test.mjs scripts/performance-compare.test.mjs",
    "check:performance": "node scripts/performance-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "mysql2": "3.24.5"
  }
}
