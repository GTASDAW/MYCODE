MYSQL_DATABASE=activity_platform
MYSQL_USER=activity
MYSQL_PASSWORD=activity_dev_password
MYSQL_ROOT_PASSWORD=local_mysql_root_password
APP_PORT=8088
SESSION_COOKIE_SECURE=false
DEMO_ADMIN_PASSWORD=Admin123!
DEMO_USER_PASSWORD=Demo123!

# Only used when compose.redis.yaml is explicitly selected.
REDIS_PASSWORD=local_redis_password
SESSION_NAMESPACE=gather:session
SESSION_TIMEOUT=30m

# Fixed windows count all CSRF-valid login/register attempts, including success.
AUTH_RATE_LIMIT_LOGIN_SOURCE_LIMIT=60
AUTH_RATE_LIMIT_LOGIN_SOURCE_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_LOGIN_PAIR_LIMIT=10
AUTH_RATE_LIMIT_LOGIN_PAIR_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REGISTER_SOURCE_LIMIT=5
AUTH_RATE_LIMIT_REGISTER_SOURCE_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_PASSWORD_ACCOUNT_LIMIT=5
AUTH_RATE_LIMIT_PASSWORD_ACCOUNT_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_PASSWORD_SOURCE_LIMIT=20
AUTH_RATE_LIMIT_PASSWORD_SOURCE_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_MAX_BUCKETS=10000
AUTH_RATE_LIMIT_NAMESPACE=gather:auth-rate-limit
# Empty means use the direct peer address. Only list exclusive, trusted proxy IPs.
AUTH_RATE_LIMIT_TRUSTED_PROXY_IPS=
